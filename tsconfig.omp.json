{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // OMP host modules are declared as untyped stubs; this config checks the extension's own logic.
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["integrations/omp/**/*.ts", "integrations/omp/**/*.d.ts"]
}
